# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it.

# --- Client bundle (Vite inlines these into the shipped JS) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# --- Server only (read by src/integrations/supabase/client.server.ts) ---
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It must never be
# exposed to the browser and must never be committed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lovable AI gateway key (server only)
LOVABLE_API_KEY=your-lovable-api-key
